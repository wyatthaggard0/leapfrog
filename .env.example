# Copy to .env and fill in to send check-ins to Google Sheets.
# Leave these blank for local play: submissions go to data/responses.json instead.

# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Option A: paste the entire service-account JSON key on one line
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: just the two fields from the key (keep the \n escapes in the key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Timezone for check-in timestamps
TIMEZONE=America/Chicago

# Local dev server port
PORT=3000
